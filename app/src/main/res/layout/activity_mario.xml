<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:orientation="vertical"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/trackYourSessionsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Track Your Sessions"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="24dp"
            android:textColor="@color/black"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />


        <TextView
        android:id="@+id/guidedText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Guided Sessions: 0 / 5"
        android:textSize="18sp"
        android:layout_marginBottom="8dp"
            android:textColor="@color/black"/>

    <ProgressBar
        android:id="@+id/guidedProgressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progress="0"
        android:max="100"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_marginBottom="8dp"
        android:progressTint="#BBDEFB"
        android:backgroundTint="#E0E0E0"/>

    <Button
        android:id="@+id/guidedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Increment Guided"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#BBDEFB"/>

    <!-- Personal Sessions Section -->
    <TextView
        android:id="@+id/personalText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Personal Sessions: 0 / 5"
        android:textSize="18sp"
        android:layout_marginBottom="8dp"
        android:textColor="@color/black"/>

    <ProgressBar
        android:id="@+id/personalProgressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progress="0"
        android:max="100"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_marginBottom="8dp"
        android:progressTint="#A5D6A7"
        android:backgroundTint="#E0E0E0"/>

    <Button
        android:id="@+id/personalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Increment Personal"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#A5D6A7"/>

    <TextView
        android:id="@+id/journalText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Journal Readings: 0 / 5"
        android:textSize="18sp"
        android:layout_marginBottom="8dp"
        android:textColor="@color/black"/>

    <ProgressBar
        android:id="@+id/journalProgressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progress="0"
        android:max="100"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_marginBottom="8dp"
        android:progressTint="#FFE0B2"
        android:backgroundTint="#E0E0E0"/>

    <Button
        android:id="@+id/journalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Increment Journal"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#FFE0B2"/>

    <!-- Meditation Sessions Section -->
    <TextView
        android:id="@+id/meditationText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Meditation Sessions: 0 / 5"
        android:textSize="18sp"
        android:layout_marginBottom="8dp"
        android:textColor="@color/black"
        />

    <ProgressBar
        android:id="@+id/meditationProgressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progress="0"
        android:max="100"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_marginBottom="8dp"
        android:progressTint="#E1BEE7"
        android:backgroundTint="#E0E0E0"/>

    <Button
        android:id="@+id/meditationButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Increment Meditation"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#E0E0E0"/>


        <TextView
            android:id="@+id/totalProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Total Progress: 0%"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:paddingBottom="16dp"
            android:textColor="@color/black"/>

        <ProgressBar
            android:id="@+id/totalProgressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progress="0"
            android:max="100"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_marginBottom="20dp"
            android:progressTint="#BBDEFB"
            android:backgroundTint="#E0E0E0"/>

</LinearLayout>


</ScrollView>
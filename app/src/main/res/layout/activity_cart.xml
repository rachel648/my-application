<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    tools:context=".CartActivity">

    <ImageView
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/baseline_arrow_back_ios_24"
        android:layout_gravity="end"
        android:paddingStart="315dp"
        android:paddingEnd="16dp"
        android:contentDescription="Back Button"
        android:layout_alignParentEnd="true" />


    <Button
        android:id="@+id/buttonCheckOutCart"
        android:layout_width="179dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="108dp"
        android:layout_marginRight="108dp"
        android:layout_marginBottom="40dp"
        android:backgroundTint="@color/lightblue"
        android:hint="Go To Cart"
        android:text="Checkout"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textviewBuyCheckoutTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PURCHASE EQUIPMENT"
        android:textColor="#C8FBFBFB"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/TextviewGymDetailsName"
        app:layout_constraintVertical_bias="0.048"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/TextviewGymDetailsName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="24*FITNESS"
        android:textColor="#C8FBFBFB"
        android:textSize="34dp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="115dp"
        tools:layout_editor_absoluteY="108dp"
        app:layout_constraintTop_toBottomOf="@+id/textviewBuyCheckoutTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"  />

    <ListView
        android:id="@+id/listviewCheckout"
        android:layout_width="386dp"
        android:layout_height="293dp"
        android:layout_margin="10dp"
        android:layout_marginEnd="8dp"
        android:layout_marginRight="8dp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        tools:layout_editor_absoluteY="45dp" />

    <Button
        android:id="@+id/buttonCheckoutback"
        android:layout_width="105dp"
        android:layout_height="57dp"
        android:layout_marginEnd="28dp"
        android:layout_marginRight="28dp"
        android:layout_marginBottom="28dp"
        android:backgroundTint="@color/lightblue"
        android:text="BACK"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/CheckoutDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:text="Select Date"
        android:textColor="@color/white"
        android:visibility="visible"
        app:layout_constraintEnd_toStartOf="@+id/buttonCheckoutDate"
        app:layout_constraintHorizontal_bias="0.267"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/CheckoutTime" />

    <TextView
        android:id="@+id/CheckoutTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="40dp"
        android:text="Select Time"
        android:textColor="@color/white"
        android:visibility="visible"
        app:layout_constraintEnd_toStartOf="@+id/buttonCheckoutTime"
        app:layout_constraintHorizontal_bias="0.138"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewTotalCost"
        tools:layout_editor_absoluteY="654dp" />

    <Button
        android:id="@+id/buttonCheckoutDate"
        style="?android:spinnerStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="16dp"
        android:text="27/10/2023"
        android:textColor="@color/white"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonCheckoutTime" />

    <Button
        android:id="@+id/buttonCheckoutTime"
        style="?android:spinnerStyle"
        android:layout_width="114dp"
        android:layout_height="38dp"
        android:layout_marginTop="40dp"
        android:text="10:00"
        android:textColor="@color/white"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewTotalCost" />

    <TextView
        android:id="@+id/textViewTotalCost"
        android:layout_width="184dp"
        android:layout_height="30dp"
        android:layout_marginTop="8dp"
        android:hint="username"
        android:text="Total Cost"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/listviewCheckout"
        tools:layout_editor_absoluteX="142dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintEnd_toStartOf="@+id/buttonCheckoutTime"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
